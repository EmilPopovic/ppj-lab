      <deklaracija_parametra>
       <specifikatori_deklaracije>
        <specifikator_tipa>
         KR_VOID 1 void
     D_ZAGRADA 1 )
   <slozena_naredba>
    L_VIT_ZAGRADA 1 {
    <lista_deklaracija>
     <lista_deklaracija>
      <lista_deklaracija>
       <lista_deklaracija>
        <deklaracija>
