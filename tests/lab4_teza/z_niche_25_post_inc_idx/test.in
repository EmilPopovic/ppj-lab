<prijevodna_jedinica>
 <prijevodna_jedinica>
  <vanjska_deklaracija>
   <deklaracija>
    <ime_tipa>
     <specifikator_tipa>
      KR_INT 1 int
    <lista_init_deklaratora>
     <init_deklarator>
      <izravni_deklarator>
       IDN 1 a
       L_UGL_ZAGRADA 1 [
       BROJ 1 5
       D_UGL_ZAGRADA 1 ]
      OP_PRIDRUZI 1 =
      <inicijalizator>
       L_VIT_ZAGRADA 1 {
       <lista_izraza_pridruzivanja>
        <lista_izraza_pridruzivanja>
         <lista_izraza_pridruzivanja>
          <lista_izraza_pridruzivanja>
           <lista_izraza_pridruzivanja>
            <izraz_pridruzivanja>
             <log_ili_izraz>
              <log_i_izraz>
               <bin_ili_izraz>
                <bin_xili_izraz>
                 <bin_i_izraz>
                  <jednakosni_izraz>
                   <odnosni_izraz>
                    <aditivni_izraz>
                     <multiplikativni_izraz>
                      <cast_izraz>
                       <unarni_izraz>
                        <postfiks_izraz>
                         <primarni_izraz>
                          BROJ 1 10
           ZAREZ 1 ,
           <izraz_pridruzivanja>
            <log_ili_izraz>
             <log_i_izraz>
              <bin_ili_izraz>
               <bin_xili_izraz>
                <bin_i_izraz>
                 <jednakosni_izraz>
                  <odnosni_izraz>
                   <aditivni_izraz>
                    <multiplikativni_izraz>
                     <cast_izraz>
                      <unarni_izraz>
                       <postfiks_izraz>
                        <primarni_izraz>
                         BROJ 1 20
          ZAREZ 1 ,
          <izraz_pridruzivanja>
           <log_ili_izraz>
            <log_i_izraz>
             <bin_ili_izraz>
              <bin_xili_izraz>
               <bin_i_izraz>
                <jednakosni_izraz>
                 <odnosni_izraz>
                  <aditivni_izraz>
                   <multiplikativni_izraz>
                    <cast_izraz>
                     <unarni_izraz>
                      <postfiks_izraz>
                       <primarni_izraz>
                        BROJ 1 30
         ZAREZ 1 ,
         <izraz_pridruzivanja>
          <log_ili_izraz>
           <log_i_izraz>
            <bin_ili_izraz>
             <bin_xili_izraz>
              <bin_i_izraz>
               <jednakosni_izraz>
                <odnosni_izraz>
                 <aditivni_izraz>
                  <multiplikativni_izraz>
                   <cast_izraz>
                    <unarni_izraz>
                     <postfiks_izraz>
                      <primarni_izraz>
                       BROJ 1 40
        ZAREZ 1 ,
        <izraz_pridruzivanja>
         <log_ili_izraz>
          <log_i_izraz>
           <bin_ili_izraz>
            <bin_xili_izraz>
             <bin_i_izraz>
              <jednakosni_izraz>
               <odnosni_izraz>
                <aditivni_izraz>
                 <multiplikativni_izraz>
                  <cast_izraz>
                   <unarni_izraz>
                    <postfiks_izraz>
                     <primarni_izraz>
                      BROJ 1 50
       D_VIT_ZAGRADA 1 }
    TOCKAZAREZ 1 ;
 <vanjska_deklaracija>
  <definicija_funkcije>
   <ime_tipa>
    <specifikator_tipa>
     KR_INT 2 int
   IDN 2 main
   L_ZAGRADA 2 (
   KR_VOID 2 void
   D_ZAGRADA 2 )
   <slozena_naredba>
    L_VIT_ZAGRADA 2 {
    <lista_deklaracija>
     <lista_deklaracija>
      <deklaracija>
       <ime_tipa>
        <specifikator_tipa>
         KR_INT 3 int
       <lista_init_deklaratora>
        <init_deklarator>
         <izravni_deklarator>
          IDN 3 i
         OP_PRIDRUZI 3 =
         <inicijalizator>
          <izraz_pridruzivanja>
           <log_ili_izraz>
            <log_i_izraz>
             <bin_ili_izraz>
              <bin_xili_izraz>
               <bin_i_izraz>
                <jednakosni_izraz>
                 <odnosni_izraz>
                  <aditivni_izraz>
                   <multiplikativni_izraz>
                    <cast_izraz>
                     <unarni_izraz>
                      <postfiks_izraz>
                       <primarni_izraz>
                        BROJ 3 1
       TOCKAZAREZ 3 ;
     <deklaracija>
      <ime_tipa>
       <specifikator_tipa>
        KR_INT 4 int
      <lista_init_deklaratora>
       <init_deklarator>
        <izravni_deklarator>
         IDN 4 val
        OP_PRIDRUZI 4 =
        <inicijalizator>
         <izraz_pridruzivanja>
          <log_ili_izraz>
           <log_i_izraz>
            <bin_ili_izraz>
             <bin_xili_izraz>
              <bin_i_izraz>
               <jednakosni_izraz>
                <odnosni_izraz>
                 <aditivni_izraz>
                  <multiplikativni_izraz>
                   <cast_izraz>
                    <unarni_izraz>
                     <postfiks_izraz>
                      <postfiks_izraz>
                       <primarni_izraz>
                        IDN 4 a
                      L_UGL_ZAGRADA 4 [
                      <izraz>
                       <izraz_pridruzivanja>
                        <log_ili_izraz>
                         <log_i_izraz>
                          <bin_ili_izraz>
                           <bin_xili_izraz>
                            <bin_i_izraz>
                             <jednakosni_izraz>
                              <odnosni_izraz>
                               <aditivni_izraz>
                                <multiplikativni_izraz>
                                 <cast_izraz>
                                  <unarni_izraz>
                                   <postfiks_izraz>
                                    <primarni_izraz>
                                     IDN 4 i
                      D_UGL_ZAGRADA 4 ]
      TOCKAZAREZ 4 ;
    <lista_naredbi>
     <lista_naredbi>
      <naredba>
       <izraz_naredba>
        <izraz>
         <izraz_pridruzivanja>
          <postfiks_izraz>
           <primarni_izraz>
            IDN 5 i
          OP_PRIDRUZI 5 =
          <izraz_pridruzivanja>
           <log_ili_izraz>
            <log_i_izraz>
             <bin_ili_izraz>
              <bin_xili_izraz>
               <bin_i_izraz>
                <jednakosni_izraz>
                 <odnosni_izraz>
                  <aditivni_izraz>
                   <aditivni_izraz>
                    <multiplikativni_izraz>
                     <cast_izraz>
                      <unarni_izraz>
                       <postfiks_izraz>
                        <primarni_izraz>
                         IDN 5 i
                   PLUS 5 +
                   <multiplikativni_izraz>
                    <cast_izraz>
                     <unarni_izraz>
                      <postfiks_izraz>
                       <primarni_izraz>
                        BROJ 5 1
        TOCKAZAREZ 5 ;
     <naredba>
      <naredba_skoka>
       KR_RETURN 6 return
       <izraz>
        <izraz_pridruzivanja>
         <log_ili_izraz>
          <log_i_izraz>
           <bin_ili_izraz>
            <bin_xili_izraz>
             <bin_i_izraz>
              <jednakosni_izraz>
               <odnosni_izraz>
                <aditivni_izraz>
                 <aditivni_izraz>
                  <multiplikativni_izraz>
                   <cast_izraz>
                    <unarni_izraz>
                     <postfiks_izraz>
                      <primarni_izraz>
                       IDN 6 val
                 PLUS 6 +
                 <multiplikativni_izraz>
                  <cast_izraz>
                   <unarni_izraz>
                    <postfiks_izraz>
                     <primarni_izraz>
                      IDN 6 i
       TOCKAZAREZ 6 ;
    D_VIT_ZAGRADA 7 }
