    <ime_tipa>
     <specifikator_tipa>
      KR_INT 1 int
    <lista_init_deklaratora>
     <init_deklarator>
      <izravni_deklarator>
       IDN 1 a
       L_UGL_ZAGRADA 1 [
       BROJ 1 10
       D_UGL_ZAGRADA 1 ]
      OP_PRIDRUZI 1 =
      <inicijalizator>
       L_VIT_ZAGRADA 1 {
       <lista_izraza_pridruzivanja>
        <lista_izraza_pridruzivanja>
         <lista_izraza_pridruzivanja>
          <lista_izraza_pridruzivanja>
           <lista_izraza_pridruzivanja>
            <lista_izraza_pridruzivanja>
             <lista_izraza_pridruzivanja>
              <lista_izraza_pridruzivanja>
               <lista_izraza_pridruzivanja>
                <lista_izraza_pridruzivanja>
                 <izraz_pridruzivanja>
                  <log_ili_izraz>
                   <log_i_izraz>
                    <bin_ili_izraz>
                     <bin_xili_izraz>
                      <bin_i_izraz>
                       <jednakosni_izraz>
                        <odnosni_izraz>
                         <aditivni_izraz>
                          <multiplikativni_izraz>
                           <cast_izraz>
                            <unarni_izraz>
                             <postfiks_izraz>
                              <primarni_izraz>
                               BROJ 1 0
                ZAREZ 1 ,
                <izraz_pridruzivanja>
                 <log_ili_izraz>
                  <log_i_izraz>
                   <bin_ili_izraz>
                    <bin_xili_izraz>
                     <bin_i_izraz>
                      <jednakosni_izraz>
                       <odnosni_izraz>
                        <aditivni_izraz>
                         <multiplikativni_izraz>
                          <cast_izraz>
