   D_ZAGRADA 1 )
   <slozena_naredba>
    L_VIT_ZAGRADA 1 {
    <lista_deklaracija>
     <deklaracija>
      <ime_tipa>
       <specifikator_tipa>
        KR_CHAR 2 char
      <lista_init_deklaratora>
       <init_deklarator>
        <izravni_deklarator>
         IDN 2 c
        OP_PRIDRUZI 2 =
        <inicijalizator>
         <izraz_pridruzivanja>
          <log_ili_izraz>
           <log_i_izraz>
            <bin_ili_izraz>
             <bin_xili_izraz>
              <bin_i_izraz>
               <jednakosni_izraz>
                <odnosni_izraz>
                 <aditivni_izraz>
                  <multiplikativni_izraz>
                   <cast_izraz>
                    L_ZAGRADA 2 (
                    <ime_tipa>
                     <specifikator_tipa>
                      KR_CHAR 2 char
                    D_ZAGRADA 2 )
                    <cast_izraz>
                     <unarni_izraz>
                      <postfiks_izraz>
                       <primarni_izraz>
                        L_ZAGRADA 2 (
                        <izraz>
                         <izraz_pridruzivanja>
                          <log_ili_izraz>
                           <log_i_izraz>
                            <bin_ili_izraz>
                             <bin_xili_izraz>
                              <bin_i_izraz>
                               <jednakosni_izraz>
                                <odnosni_izraz>
                                 <aditivni_izraz>
                                  <aditivni_izraz>
                                   <multiplikativni_izraz>
                                    <cast_izraz>
                                     <unarni_izraz>
                                      <postfiks_izraz>
                                       <primarni_izraz>
                                        ZNAK 2 'a'
                                  PLUS 2 +
                                  <multiplikativni_izraz>
                                   <cast_izraz>
                                    <unarni_izraz>
                                     <postfiks_izraz>
                                      <primarni_izraz>
                                       BROJ 2 1
                        D_ZAGRADA 2 )
      TOCKAZAREZ 2 ;
    <lista_naredbi>
     <lista_naredbi>
      <naredba>
       <naredba_grananja>
        KR_IF 3 if
        L_ZAGRADA 3 (
        <izraz>
         <izraz_pridruzivanja>
          <log_ili_izraz>
           <log_i_izraz>
            <bin_ili_izraz>
             <bin_xili_izraz>
              <bin_i_izraz>
               <jednakosni_izraz>
                <jednakosni_izraz>
                 <odnosni_izraz>
                  <aditivni_izraz>
                   <multiplikativni_izraz>
                    <cast_izraz>
                     <unarni_izraz>
                      <postfiks_izraz>
                       <primarni_izraz>
                        IDN 3 c
                OP_EQ 3 ==
                <odnosni_izraz>
                 <aditivni_izraz>
                  <multiplikativni_izraz>
                   <cast_izraz>
                    <unarni_izraz>
                     <postfiks_izraz>
                      <primarni_izraz>
                       ZNAK 3 'b'
        D_ZAGRADA 3 )
        <naredba>
         <naredba_skoka>
          KR_RETURN 3 return
          <izraz>
           <izraz_pridruzivanja>
            <log_ili_izraz>
             <log_i_izraz>
              <bin_ili_izraz>
               <bin_xili_izraz>
                <bin_i_izraz>
                 <jednakosni_izraz>
                  <odnosni_izraz>
                   <aditivni_izraz>
                    <multiplikativni_izraz>
                     <cast_izraz>
                      <unarni_izraz>
                       <postfiks_izraz>
                        <primarni_izraz>
                         BROJ 3 1
          TOCKAZAREZ 3 ;
     <naredba>
      <naredba_skoka>
       KR_RETURN 4 return
       <izraz>
        <izraz_pridruzivanja>
         <log_ili_izraz>
          <log_i_izraz>
           <bin_ili_izraz>
            <bin_xili_izraz>
