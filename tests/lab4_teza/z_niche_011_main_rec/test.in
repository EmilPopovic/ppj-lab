<prijevodna_jedinica>
 <prijevodna_jedinica>
  <vanjska_deklaracija>
   <deklaracija>
    <ime_tipa>
     <specifikator_tipa>
      KR_INT 1 int
    <lista_init_deklaratora>
     <init_deklarator>
      <izravni_deklarator>
       IDN 1 count
      OP_PRIDRUZI 1 =
      <inicijalizator>
       <izraz_pridruzivanja>
        <log_ili_izraz>
         <log_i_izraz>
          <bin_ili_izraz>
           <bin_xili_izraz>
            <bin_i_izraz>
             <jednakosni_izraz>
              <odnosni_izraz>
               <aditivni_izraz>
                <multiplikativni_izraz>
                 <cast_izraz>
                  <unarni_izraz>
                   <postfiks_izraz>
                    <primarni_izraz>
                     BROJ 1 5
    TOCKAZAREZ 1 ;
 <vanjska_deklaracija>
  <definicija_funkcije>
   <ime_tipa>
    <specifikator_tipa>
     KR_INT 2 int
   IDN 2 main
   L_ZAGRADA 2 (
   KR_VOID 2 void
   D_ZAGRADA 2 )
   <slozena_naredba>
    L_VIT_ZAGRADA 2 {
    <lista_naredbi>
     <lista_naredbi>
      <lista_naredbi>
       <naredba>
        <naredba_grananja>
         KR_IF 3 if
         L_ZAGRADA 3 (
         <izraz>
          <izraz_pridruzivanja>
           <log_ili_izraz>
            <log_i_izraz>
             <bin_ili_izraz>
              <bin_xili_izraz>
               <bin_i_izraz>
                <jednakosni_izraz>
                 <jednakosni_izraz>
                  <odnosni_izraz>
                   <aditivni_izraz>
                    <multiplikativni_izraz>
                     <cast_izraz>
                      <unarni_izraz>
                       <postfiks_izraz>
                        <primarni_izraz>
                         IDN 3 count
                 OP_EQ 3 ==
                 <odnosni_izraz>
                  <aditivni_izraz>
                   <multiplikativni_izraz>
                    <cast_izraz>
                     <unarni_izraz>
                      <postfiks_izraz>
                       <primarni_izraz>
                        BROJ 3 0
         D_ZAGRADA 3 )
         <naredba>
          <naredba_skoka>
           KR_RETURN 3 return
           <izraz>
            <izraz_pridruzivanja>
             <log_ili_izraz>
              <log_i_izraz>
               <bin_ili_izraz>
                <bin_xili_izraz>
                 <bin_i_izraz>
                  <jednakosni_izraz>
                   <odnosni_izraz>
                    <aditivni_izraz>
                     <multiplikativni_izraz>
                      <cast_izraz>
                       <unarni_izraz>
                        <postfiks_izraz>
                         <primarni_izraz>
                          BROJ 3 100
           TOCKAZAREZ 3 ;
      <naredba>
       <izraz_naredba>
        <izraz>
         <izraz_pridruzivanja>
          <postfiks_izraz>
           <primarni_izraz>
            IDN 4 count
          OP_PRIDRUZI 4 =
          <izraz_pridruzivanja>
           <log_ili_izraz>
            <log_i_izraz>
             <bin_ili_izraz>
              <bin_xili_izraz>
               <bin_i_izraz>
                <jednakosni_izraz>
                 <odnosni_izraz>
                  <aditivni_izraz>
                   <aditivni_izraz>
                    <multiplikativni_izraz>
                     <cast_izraz>
                      <unarni_izraz>
                       <postfiks_izraz>
                        <primarni_izraz>
                         IDN 4 count
                   MINUS 4 -
                   <multiplikativni_izraz>
                    <cast_izraz>
                     <unarni_izraz>
                      <postfiks_izraz>
                       <primarni_izraz>
                        BROJ 4 1
        TOCKAZAREZ 4 ;
     <naredba>
      <naredba_skoka>
       KR_RETURN 5 return
       <izraz>
        <izraz_pridruzivanja>
         <log_ili_izraz>
          <log_i_izraz>
           <bin_ili_izraz>
            <bin_xili_izraz>
             <bin_i_izraz>
              <jednakosni_izraz>
               <odnosni_izraz>
                <aditivni_izraz>
                 <aditivni_izraz>
                  <multiplikativni_izraz>
                   <cast_izraz>
                    <unarni_izraz>
                     <postfiks_izraz>
                      <postfiks_izraz>
                       <primarni_izraz>
                        IDN 5 main
                      L_ZAGRADA 5 (
                      D_ZAGRADA 5 )
                 PLUS 5 +
                 <multiplikativni_izraz>
                  <cast_izraz>
                   <unarni_izraz>
                    <postfiks_izraz>
                     <primarni_izraz>
                      BROJ 5 1
       TOCKAZAREZ 5 ;
    D_VIT_ZAGRADA 6 }
