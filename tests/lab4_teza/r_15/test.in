<prijevodna_jedinica>
 <prijevodna_jedinica>
  <vanjska_deklaracija>
   <deklaracija>
    <ime_tipa>
     <specifikator_tipa>
      KR_INT 1 int
    <lista_init_deklaratora>
     <init_deklarator>
      <izravni_deklarator>
       IDN 1 g
       L_UGL_ZAGRADA 1 [
       BROJ 1 5
       D_UGL_ZAGRADA 1 ]
      OP_PRIDRUZI 1 =
      <inicijalizator>
       L_VIT_ZAGRADA 1 {
       <lista_izraza_pridruzivanja>
        <lista_izraza_pridruzivanja>
         <lista_izraza_pridruzivanja>
          <lista_izraza_pridruzivanja>
           <lista_izraza_pridruzivanja>
            <izraz_pridruzivanja>
             <log_ili_izraz>
              <log_i_izraz>
               <bin_ili_izraz>
                <bin_xili_izraz>
                 <bin_i_izraz>
                  <jednakosni_izraz>
                   <odnosni_izraz>
                    <aditivni_izraz>
                     <multiplikativni_izraz>
                      <cast_izraz>
                       <unarni_izraz>
                        <postfiks_izraz>
                         <primarni_izraz>
                          BROJ 1 1
           ZAREZ 1 ,
           <izraz_pridruzivanja>
            <log_ili_izraz>
             <log_i_izraz>
              <bin_ili_izraz>
               <bin_xili_izraz>
                <bin_i_izraz>
                 <jednakosni_izraz>
                  <odnosni_izraz>
                   <aditivni_izraz>
                    <multiplikativni_izraz>
                     <cast_izraz>
                      <unarni_izraz>
                       <postfiks_izraz>
                        <primarni_izraz>
                         BROJ 1 2
          ZAREZ 1 ,
          <izraz_pridruzivanja>
           <log_ili_izraz>
            <log_i_izraz>
             <bin_ili_izraz>
              <bin_xili_izraz>
               <bin_i_izraz>
                <jednakosni_izraz>
                 <odnosni_izraz>
                  <aditivni_izraz>
                   <multiplikativni_izraz>
                    <cast_izraz>
                     <unarni_izraz>
                      <postfiks_izraz>
                       <primarni_izraz>
                        BROJ 1 3
         ZAREZ 1 ,
         <izraz_pridruzivanja>
          <log_ili_izraz>
           <log_i_izraz>
            <bin_ili_izraz>
             <bin_xili_izraz>
              <bin_i_izraz>
               <jednakosni_izraz>
                <odnosni_izraz>
                 <aditivni_izraz>
                  <multiplikativni_izraz>
                   <cast_izraz>
                    <unarni_izraz>
                     <postfiks_izraz>
                      <primarni_izraz>
                       BROJ 1 4
        ZAREZ 1 ,
        <izraz_pridruzivanja>
         <log_ili_izraz>
          <log_i_izraz>
           <bin_ili_izraz>
            <bin_xili_izraz>
             <bin_i_izraz>
              <jednakosni_izraz>
               <odnosni_izraz>
                <aditivni_izraz>
                 <multiplikativni_izraz>
                  <cast_izraz>
                   <unarni_izraz>
                    <postfiks_izraz>
                     <primarni_izraz>
                      BROJ 1 5
       D_VIT_ZAGRADA 1 }
    TOCKAZAREZ 1 ;
 <vanjska_deklaracija>
  <definicija_funkcije>
   <ime_tipa>
    <specifikator_tipa>
     KR_INT 2 int
   IDN 2 main
   L_ZAGRADA 2 (
   KR_VOID 2 void
   D_ZAGRADA 2 )
   <slozena_naredba>
    L_VIT_ZAGRADA 2 {
    <lista_deklaracija>
     <lista_deklaracija>
      <deklaracija>
       <ime_tipa>
        <specifikator_tipa>
         KR_INT 3 int
       <lista_init_deklaratora>
        <init_deklarator>
         <izravni_deklarator>
          IDN 3 i
       TOCKAZAREZ 3 ;
     <deklaracija>
      <ime_tipa>
       <specifikator_tipa>
        KR_INT 4 int
      <lista_init_deklaratora>
       <init_deklarator>
        <izravni_deklarator>
         IDN 4 sum
        OP_PRIDRUZI 4 =
        <inicijalizator>
         <izraz_pridruzivanja>
          <log_ili_izraz>
           <log_i_izraz>
            <bin_ili_izraz>
             <bin_xili_izraz>
              <bin_i_izraz>
               <jednakosni_izraz>
                <odnosni_izraz>
                 <aditivni_izraz>
                  <multiplikativni_izraz>
                   <cast_izraz>
                    <unarni_izraz>
                     <postfiks_izraz>
                      <primarni_izraz>
                       BROJ 4 0
      TOCKAZAREZ 4 ;
    <lista_naredbi>
     <lista_naredbi>
      <naredba>
       <naredba_petlje>
        KR_FOR 5 for
        L_ZAGRADA 5 (
        <izraz_naredba>
         <izraz>
          <izraz_pridruzivanja>
           <postfiks_izraz>
            <primarni_izraz>
             IDN 5 i
           OP_PRIDRUZI 5 =
           <izraz_pridruzivanja>
            <log_ili_izraz>
             <log_i_izraz>
              <bin_ili_izraz>
               <bin_xili_izraz>
                <bin_i_izraz>
                 <jednakosni_izraz>
                  <odnosni_izraz>
                   <aditivni_izraz>
                    <multiplikativni_izraz>
                     <cast_izraz>
                      <unarni_izraz>
                       <postfiks_izraz>
                        <primarni_izraz>
                         BROJ 5 0
         TOCKAZAREZ 5 ;
        <izraz_naredba>
         <izraz>
          <izraz_pridruzivanja>
           <log_ili_izraz>
            <log_i_izraz>
             <bin_ili_izraz>
              <bin_xili_izraz>
               <bin_i_izraz>
                <jednakosni_izraz>
                 <odnosni_izraz>
                  <odnosni_izraz>
                   <aditivni_izraz>
                    <multiplikativni_izraz>
                     <cast_izraz>
                      <unarni_izraz>
                       <postfiks_izraz>
                        <primarni_izraz>
                         IDN 5 i
                  OP_LT 5 <
                  <aditivni_izraz>
                   <multiplikativni_izraz>
                    <cast_izraz>
                     <unarni_izraz>
                      <postfiks_izraz>
                       <primarni_izraz>
                        BROJ 5 5
         TOCKAZAREZ 5 ;
        <izraz>
         <izraz_pridruzivanja>
          <postfiks_izraz>
           <primarni_izraz>
            IDN 5 i
          OP_PRIDRUZI 5 =
          <izraz_pridruzivanja>
           <log_ili_izraz>
            <log_i_izraz>
             <bin_ili_izraz>
              <bin_xili_izraz>
               <bin_i_izraz>
                <jednakosni_izraz>
                 <odnosni_izraz>
                  <aditivni_izraz>
                   <aditivni_izraz>
                    <multiplikativni_izraz>
                     <cast_izraz>
                      <unarni_izraz>
                       <postfiks_izraz>
                        <primarni_izraz>
                         IDN 5 i
                   PLUS 5 +
                   <multiplikativni_izraz>
                    <cast_izraz>
                     <unarni_izraz>
                      <postfiks_izraz>
                       <primarni_izraz>
                        BROJ 5 1
        D_ZAGRADA 5 )
        <naredba>
         <slozena_naredba>
          L_VIT_ZAGRADA 5 {
          <lista_naredbi>
           <naredba>
            <izraz_naredba>
             <izraz>
              <izraz_pridruzivanja>
               <postfiks_izraz>
                <primarni_izraz>
                 IDN 6 sum
               OP_PRIDRUZI 6 =
               <izraz_pridruzivanja>
                <log_ili_izraz>
                 <log_i_izraz>
                  <bin_ili_izraz>
                   <bin_xili_izraz>
                    <bin_i_izraz>
                     <jednakosni_izraz>
                      <odnosni_izraz>
                       <aditivni_izraz>
                        <aditivni_izraz>
                         <multiplikativni_izraz>
                          <cast_izraz>
                           <unarni_izraz>
                            <postfiks_izraz>
                             <primarni_izraz>
                              IDN 6 sum
                        PLUS 6 +
                        <multiplikativni_izraz>
                         <cast_izraz>
                          <unarni_izraz>
                           <postfiks_izraz>
                            <postfiks_izraz>
                             <primarni_izraz>
                              IDN 6 g
                            L_UGL_ZAGRADA 6 [
                            <izraz>
                             <izraz_pridruzivanja>
                              <log_ili_izraz>
                               <log_i_izraz>
                                <bin_ili_izraz>
                                 <bin_xili_izraz>
                                  <bin_i_izraz>
                                   <jednakosni_izraz>
                                    <odnosni_izraz>
                                     <aditivni_izraz>
                                      <multiplikativni_izraz>
                                       <cast_izraz>
                                        <unarni_izraz>
                                         <postfiks_izraz>
                                          <primarni_izraz>
                                           IDN 6 i
                            D_UGL_ZAGRADA 6 ]
             TOCKAZAREZ 6 ;
          D_VIT_ZAGRADA 7 }
     <naredba>
      <naredba_skoka>
       KR_RETURN 8 return
       <izraz>
        <izraz_pridruzivanja>
         <log_ili_izraz>
          <log_i_izraz>
           <bin_ili_izraz>
            <bin_xili_izraz>
             <bin_i_izraz>
              <jednakosni_izraz>
               <odnosni_izraz>
                <aditivni_izraz>
                 <multiplikativni_izraz>
                  <cast_izraz>
                   <unarni_izraz>
                    <postfiks_izraz>
                     <primarni_izraz>
                      IDN 8 sum
       TOCKAZAREZ 8 ;
    D_VIT_ZAGRADA 9 }
