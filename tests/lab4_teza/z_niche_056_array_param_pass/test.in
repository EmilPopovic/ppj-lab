                                 <cast_izraz>
                                  <unarni_izraz>
                                   <postfiks_izraz>
                                    <primarni_izraz>
                                     BROJ 2 1
                      D_UGL_ZAGRADA 2 ]
        TOCKAZAREZ 2 ;
     D_VIT_ZAGRADA 3 }
 <vanjska_deklaracija>
  <definicija_funkcije>
   <ime_tipa>
    <specifikator_tipa>
     KR_INT 4 int
   IDN 4 main
   L_ZAGRADA 4 (
   KR_VOID 4 void
   D_ZAGRADA 4 )
   <slozena_naredba>
    L_VIT_ZAGRADA 4 {
    <lista_deklaracija>
     <deklaracija>
      <ime_tipa>
       <specifikator_tipa>
        KR_INT 5 int
      <lista_init_deklaratora>
       <init_deklarator>
        <izravni_deklarator>
         IDN 5 b
         L_UGL_ZAGRADA 5 [
         BROJ 5 2
         D_UGL_ZAGRADA 5 ]
        OP_PRIDRUZI 5 =
        <inicijalizator>
         L_VIT_ZAGRADA 5 {
         <lista_izraza_pridruzivanja>
          <lista_izraza_pridruzivanja>
           <izraz_pridruzivanja>
            <log_ili_izraz>
             <log_i_izraz>
              <bin_ili_izraz>
               <bin_xili_izraz>
                <bin_i_izraz>
                 <jednakosni_izraz>
                  <odnosni_izraz>
                   <aditivni_izraz>
                    <multiplikativni_izraz>
                     <cast_izraz>
                      <unarni_izraz>
                       <postfiks_izraz>
                        <primarni_izraz>
                         BROJ 5 10
          ZAREZ 5 ,
          <izraz_pridruzivanja>
           <log_ili_izraz>
            <log_i_izraz>
             <bin_ili_izraz>
              <bin_xili_izraz>
               <bin_i_izraz>
                <jednakosni_izraz>
                 <odnosni_izraz>
                  <aditivni_izraz>
                   <multiplikativni_izraz>
                    <cast_izraz>
                     <unarni_izraz>
                      <postfiks_izraz>
                       <primarni_izraz>
                        BROJ 5 20
         D_VIT_ZAGRADA 5 }
      TOCKAZAREZ 5 ;
    <lista_naredbi>
     <naredba>
      <naredba_skoka>
       KR_RETURN 6 return
       <izraz>
        <izraz_pridruzivanja>
         <log_ili_izraz>
          <log_i_izraz>
           <bin_ili_izraz>
            <bin_xili_izraz>
             <bin_i_izraz>
              <jednakosni_izraz>
               <odnosni_izraz>
                <aditivni_izraz>
                 <multiplikativni_izraz>
                  <cast_izraz>
                   <unarni_izraz>
                    <postfiks_izraz>
                     <postfiks_izraz>
                      <primarni_izraz>
                       IDN 6 sum_first
                     L_ZAGRADA 6 (
                     <lista_argumenata>
                      <izraz_pridruzivanja>
                       <log_ili_izraz>
                        <log_i_izraz>
                         <bin_ili_izraz>
                          <bin_xili_izraz>
                           <bin_i_izraz>
                            <jednakosni_izraz>
                             <odnosni_izraz>
                              <aditivni_izraz>
                               <multiplikativni_izraz>
                                <cast_izraz>
                                 <unarni_izraz>
                                  <postfiks_izraz>
                                   <primarni_izraz>
                                    IDN 6 b
                     D_ZAGRADA 6 )
       TOCKAZAREZ 6 ;
    D_VIT_ZAGRADA 7 }
