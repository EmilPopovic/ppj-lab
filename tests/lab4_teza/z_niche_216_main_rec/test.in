<prijevodna_jedinica>
 <prijevodna_jedinica>
  <vanjska_deklaracija>
   <deklaracija>
    <ime_tipa>
     <specifikator_tipa>
      KR_INT 1 int
    <lista_init_deklaratora>
     <init_deklarator>
      <izravni_deklarator>
       IDN 1 count_rec
      OP_PRIDRUZI 1 =
      <inicijalizator>
       <izraz_pridruzivanja>
        <log_ili_izraz>
         <log_i_izraz>
          <bin_ili_izraz>
           <bin_xili_izraz>
            <bin_i_izraz>
             <jednakosni_izraz>
              <odnosni_izraz>
               <aditivni_izraz>
                <multiplikativni_izraz>
                 <cast_izraz>
                  <unarni_izraz>
                   <postfiks_izraz>
                    <primarni_izraz>
                     BROJ 1 0
    TOCKAZAREZ 1 ;
 <vanjska_deklaracija>
  <definicija_funkcije>
   <ime_tipa>
    <specifikator_tipa>
     KR_INT 2 int
   IDN 2 main
   L_ZAGRADA 2 (
   KR_VOID 2 void
   D_ZAGRADA 2 )
   <slozena_naredba>
    L_VIT_ZAGRADA 2 {
    <lista_naredbi>
     <lista_naredbi>
      <lista_naredbi>
       <naredba>
        <izraz_naredba>
         <izraz>
          <izraz_pridruzivanja>
           <postfiks_izraz>
            <primarni_izraz>
             IDN 3 count_rec
           OP_PRIDRUZI 3 =
           <izraz_pridruzivanja>
            <log_ili_izraz>
             <log_i_izraz>
              <bin_ili_izraz>
               <bin_xili_izraz>
                <bin_i_izraz>
                 <jednakosni_izraz>
                  <odnosni_izraz>
                   <aditivni_izraz>
                    <aditivni_izraz>
                     <multiplikativni_izraz>
                      <cast_izraz>
                       <unarni_izraz>
                        <postfiks_izraz>
                         <primarni_izraz>
                          IDN 3 count_rec
                    PLUS 3 +
                    <multiplikativni_izraz>
                     <cast_izraz>
                      <unarni_izraz>
                       <postfiks_izraz>
                        <primarni_izraz>
                         BROJ 3 1
         TOCKAZAREZ 3 ;
      <naredba>
       <naredba_grananja>
        KR_IF 4 if
        L_ZAGRADA 4 (
        <izraz>
         <izraz_pridruzivanja>
          <log_ili_izraz>
           <log_i_izraz>
            <bin_ili_izraz>
             <bin_xili_izraz>
              <bin_i_izraz>
               <jednakosni_izraz>
                <odnosni_izraz>
                 <odnosni_izraz>
                  <aditivni_izraz>
                   <multiplikativni_izraz>
                    <cast_izraz>
                     <unarni_izraz>
                      <postfiks_izraz>
                       <primarni_izraz>
                        IDN 4 count_rec
                 OP_LT 4 <
                 <aditivni_izraz>
                  <multiplikativni_izraz>
                   <cast_izraz>
                    <unarni_izraz>
                     <postfiks_izraz>
                      <primarni_izraz>
                       BROJ 4 5
        D_ZAGRADA 4 )
        <naredba>
         <slozena_naredba>
          L_VIT_ZAGRADA 4 {
          <lista_naredbi>
           <naredba>
            <izraz_naredba>
             <izraz>
              <izraz_pridruzivanja>
               <log_ili_izraz>
                <log_i_izraz>
                 <bin_ili_izraz>
                  <bin_xili_izraz>
                   <bin_i_izraz>
                    <jednakosni_izraz>
                     <odnosni_izraz>
                      <aditivni_izraz>
                       <multiplikativni_izraz>
                        <cast_izraz>
                         <unarni_izraz>
                          <postfiks_izraz>
                           <postfiks_izraz>
                            <primarni_izraz>
                             IDN 5 main
                           L_ZAGRADA 5 (
                           D_ZAGRADA 5 )
             TOCKAZAREZ 5 ;
          D_VIT_ZAGRADA 6 }
     <naredba>
      <naredba_skoka>
       KR_RETURN 7 return
       <izraz>
        <izraz_pridruzivanja>
         <log_ili_izraz>
          <log_i_izraz>
           <bin_ili_izraz>
            <bin_xili_izraz>
             <bin_i_izraz>
              <jednakosni_izraz>
               <odnosni_izraz>
                <aditivni_izraz>
                 <multiplikativni_izraz>
                  <cast_izraz>
                   <unarni_izraz>
                    <postfiks_izraz>
                     <primarni_izraz>
                      IDN 7 count_rec
       TOCKAZAREZ 7 ;
    D_VIT_ZAGRADA 8 }
