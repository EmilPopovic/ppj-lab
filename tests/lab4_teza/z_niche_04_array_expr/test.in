                <log_ili_izraz>
                 <log_i_izraz>
                  <bin_ili_izraz>
                   <bin_xili_izraz>
                    <bin_i_izraz>
                     <jednakosni_izraz>
                      <odnosni_izraz>
                       <aditivni_izraz>
                        <multiplikativni_izraz>
                         <cast_izraz>
                          <unarni_izraz>
                           <postfiks_izraz>
                            <primarni_izraz>
                             BROJ 1 2
              ZAREZ 1 ,
              <izraz_pridruzivanja>
               <log_ili_izraz>
                <log_i_izraz>
                 <bin_ili_izraz>
                  <bin_xili_izraz>
                   <bin_i_izraz>
                    <jednakosni_izraz>
                     <odnosni_izraz>
                      <aditivni_izraz>
                       <multiplikativni_izraz>
                        <cast_izraz>
                         <unarni_izraz>
                          <postfiks_izraz>
                           <primarni_izraz>
                            BROJ 1 3
             ZAREZ 1 ,
             <izraz_pridruzivanja>
              <log_ili_izraz>
               <log_i_izraz>
                <bin_ili_izraz>
                 <bin_xili_izraz>
                  <bin_i_izraz>
                   <jednakosni_izraz>
                    <odnosni_izraz>
                     <aditivni_izraz>
                      <multiplikativni_izraz>
                       <cast_izraz>
                        <unarni_izraz>
                         <postfiks_izraz>
                          <primarni_izraz>
                           BROJ 1 4
            ZAREZ 1 ,
            <izraz_pridruzivanja>
             <log_ili_izraz>
              <log_i_izraz>
               <bin_ili_izraz>
                <bin_xili_izraz>
                 <bin_i_izraz>
