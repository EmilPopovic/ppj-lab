       <specifikator_tipa>
        KR_INT 1 int
      IDN 1 x
    D_ZAGRADA 1 )
    <slozena_naredba>
     L_VIT_ZAGRADA 1 {
     <lista_deklaracija>
      <deklaracija>
       <ime_tipa>
        <specifikator_tipa>
         KR_INT 2 int
       <lista_init_deklaratora>
        <init_deklarator>
         <izravni_deklarator>
          IDN 2 a
          L_UGL_ZAGRADA 2 [
          BROJ 2 10
          D_UGL_ZAGRADA 2 ]
       TOCKAZAREZ 2 ;
     <lista_naredbi>
      <lista_naredbi>
       <lista_naredbi>
        <naredba>
         <naredba_grananja>
          KR_IF 3 if
          L_ZAGRADA 3 (
          <izraz>
           <izraz_pridruzivanja>
            <log_ili_izraz>
             <log_i_izraz>
              <bin_ili_izraz>
               <bin_xili_izraz>
                <bin_i_izraz>
                 <jednakosni_izraz>
                  <odnosni_izraz>
                   <odnosni_izraz>
                    <aditivni_izraz>
                     <multiplikativni_izraz>
                      <cast_izraz>
                       <unarni_izraz>
                        <postfiks_izraz>
                         <primarni_izraz>
                          IDN 3 x
                   OP_GT 3 >
                   <aditivni_izraz>
                    <multiplikativni_izraz>
                     <cast_izraz>
                      <unarni_izraz>
                       <postfiks_izraz>
                        <primarni_izraz>
                         BROJ 3 10
          D_ZAGRADA 3 )
          <naredba>
           <naredba_skoka>
            KR_RETURN 3 return
            <izraz>
             <izraz_pridruzivanja>
              <log_ili_izraz>
               <log_i_izraz>
                <bin_ili_izraz>
                 <bin_xili_izraz>
                  <bin_i_izraz>
                   <jednakosni_izraz>
                    <odnosni_izraz>
                     <aditivni_izraz>
                      <multiplikativni_izraz>
                       <cast_izraz>
                        <unarni_izraz>
                         <postfiks_izraz>
                          <primarni_izraz>
                           BROJ 3 1
            TOCKAZAREZ 3 ;
       <naredba>
        <naredba_grananja>
         KR_IF 4 if
         L_ZAGRADA 4 (
         <izraz>
          <izraz_pridruzivanja>
           <log_ili_izraz>
            <log_i_izraz>
             <bin_ili_izraz>
              <bin_xili_izraz>
               <bin_i_izraz>
                <jednakosni_izraz>
                 <odnosni_izraz>
                  <odnosni_izraz>
                   <aditivni_izraz>
                    <multiplikativni_izraz>
                     <cast_izraz>
                      <unarni_izraz>
                       <postfiks_izraz>
                        <primarni_izraz>
                         IDN 4 x
                  OP_LT 4 <
                  <aditivni_izraz>
                   <multiplikativni_izraz>
                    <cast_izraz>
                     <unarni_izraz>
                      <postfiks_izraz>
                       <primarni_izraz>
                        BROJ 4 0
         D_ZAGRADA 4 )
         <naredba>
          <naredba_skoka>
           KR_RETURN 4 return
           <izraz>
            <izraz_pridruzivanja>
             <log_ili_izraz>
              <log_i_izraz>
               <bin_ili_izraz>
                <bin_xili_izraz>
                 <bin_i_izraz>
                  <jednakosni_izraz>
                   <odnosni_izraz>
                    <aditivni_izraz>
                     <multiplikativni_izraz>
                      <cast_izraz>
                       <unarni_izraz>
                        <unarni_operator>
                         MINUS 4 -
                        <cast_izraz>
                         <unarni_izraz>
                          <postfiks_izraz>
                           <primarni_izraz>
                            BROJ 4 1
           TOCKAZAREZ 4 ;
      <naredba>
       <naredba_skoka>
        KR_RETURN 5 return
        <izraz>
         <izraz_pridruzivanja>
          <log_ili_izraz>
           <log_i_izraz>
            <bin_ili_izraz>
             <bin_xili_izraz>
              <bin_i_izraz>
               <jednakosni_izraz>
                <odnosni_izraz>
                 <aditivni_izraz>
                  <multiplikativni_izraz>
                   <cast_izraz>
                    <unarni_izraz>
                     <postfiks_izraz>
                      <primarni_izraz>
                       BROJ 5 0
        TOCKAZAREZ 5 ;
     D_VIT_ZAGRADA 6 }
