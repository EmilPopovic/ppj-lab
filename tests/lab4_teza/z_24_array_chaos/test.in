          <specifikator_tipa>
           KR_INT 2 int
         <lista_init_deklaratora>
          <init_deklarator>
           <deklarator>
            <izravni_deklarator>
             <izravni_deklarator>
              IDN 2 arr1
             L_UGL_ZAGRADA 2 [
             <log_ili_izraz>
              <log_i_izraz>
               <bin_ili_izraz>
                <bin_xili_izraz>
                 <bin_i_izraz>
                  <jednakosni_izraz>
                   <odnosni_izraz>
                    <aditivni_izraz>
                     <multiplikativni_izraz>
                      <cast_izraz>
                       <unarni_izraz>
                        <postfiks_izraz>
                         <primarni_izraz>
                          BROJ 2 50
             D_UGL_ZAGRADA 2 ]
         TOCKAZAREZ 2 ;
       <deklaracija>
        <specifikatori_deklaracije>
         <specifikator_tipa>
