       <lista_init_deklaratora>
        <init_deklarator>
         <deklarator>
          <izravni_deklarator>
           <izravni_deklarator>
            IDN 4 arr3
           L_UGL_ZAGRADA 4 [
           <log_ili_izraz>
            <log_i_izraz>
             <bin_ili_izraz>
              <bin_xili_izraz>
               <bin_i_izraz>
                <jednakosni_izraz>
                 <odnosni_izraz>
                  <aditivni_izraz>
                   <multiplikativni_izraz>
