 <vanjska_deklaracija>
  <definicija_funkcije>
   <ime_tipa>
    <specifikator_tipa>
     KR_INT 2 int
   IDN 2 main
   L_ZAGRADA 2 (
   KR_VOID 2 void
   D_ZAGRADA 2 )
   <slozena_naredba>
    L_VIT_ZAGRADA 2 {
    <lista_deklaracija>
     <deklaracija>
      <ime_tipa>
       <specifikator_tipa>
        KR_INT 3 int
      <lista_init_deklaratora>
       <init_deklarator>
        <izravni_deklarator>
         IDN 3 i
        OP_PRIDRUZI 3 =
        <inicijalizator>
         <izraz_pridruzivanja>
          <log_ili_izraz>
           <log_i_izraz>
            <bin_ili_izraz>
             <bin_xili_izraz>
              <bin_i_izraz>
               <jednakosni_izraz>
                <odnosni_izraz>
                 <aditivni_izraz>
                  <multiplikativni_izraz>
                   <cast_izraz>
                    <unarni_izraz>
                     <postfiks_izraz>
                      <primarni_izraz>
                       BROJ 3 2
      TOCKAZAREZ 3 ;
    <lista_naredbi>
     <naredba>
      <naredba_skoka>
       KR_RETURN 4 return
       <izraz>
        <izraz_pridruzivanja>
         <log_ili_izraz>
          <log_i_izraz>
           <bin_ili_izraz>
            <bin_xili_izraz>
             <bin_i_izraz>
              <jednakosni_izraz>
               <odnosni_izraz>
                <aditivni_izraz>
                 <multiplikativni_izraz>
                  <cast_izraz>
                   <unarni_izraz>
                    <postfiks_izraz>
                     <postfiks_izraz>
                      <primarni_izraz>
                       IDN 4 a
                     L_UGL_ZAGRADA 4 [
                     <izraz>
                      <izraz_pridruzivanja>
                       <log_ili_izraz>
                        <log_i_izraz>
                         <bin_ili_izraz>
                          <bin_xili_izraz>
                           <bin_i_izraz>
                            <jednakosni_izraz>
                             <odnosni_izraz>
                              <aditivni_izraz>
                               <aditivni_izraz>
                                <multiplikativni_izraz>
                                 <multiplikativni_izraz>
                                  <cast_izraz>
                                   <unarni_izraz>
                                    <postfiks_izraz>
                                     <postfiks_izraz>
                                      <primarni_izraz>
                                       IDN 4 a
                                     L_UGL_ZAGRADA 4 [
                                     <izraz>
                                      <izraz_pridruzivanja>
                                       <log_ili_izraz>
                                        <log_i_izraz>
                                         <bin_ili_izraz>
                                          <bin_xili_izraz>
                                           <bin_i_izraz>
                                            <jednakosni_izraz>
                                             <odnosni_izraz>
                                              <aditivni_izraz>
                                               <multiplikativni_izraz>
                                                <cast_izraz>
                                                 <unarni_izraz>
                                                  <postfiks_izraz>
                                                   <primarni_izraz>
                                                    IDN 4 i
                                     D_UGL_ZAGRADA 4 ]
                                 OP_PUTA 4 *
                                 <cast_izraz>
                                  <unarni_izraz>
                                   <postfiks_izraz>
                                    <primarni_izraz>
                                     BROJ 4 2
                               PLUS 4 +
                               <multiplikativni_izraz>
                                <cast_izraz>
                                 <unarni_izraz>
                                  <postfiks_izraz>
                                   <primarni_izraz>
                                    BROJ 4 1
                     D_UGL_ZAGRADA 4 ]
       TOCKAZAREZ 4 ;
    D_VIT_ZAGRADA 5 }
